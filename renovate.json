{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,

  "packageRules": [
    {
      "description": "Group Cosmos NuGet packages and the custom CosmosVersion property using exact names",
      "matchPackageNames": [
        "Cosmos.Sdk",
        "Cosmos.Kernel",
        "Cosmos.Kernel.System",
        "CosmosVersion"
      ],
      "groupName": "Cosmos packages",
      "groupSlug": "cosmos-packages",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CosmosVersion property using Cosmos.Kernel versions",
      "managerFilePatterns": [
        "^src/Yukihana/Yukihana\\.csproj$"
      ],
      "matchStrings": [
        "<CosmosVersion>(?<currentValue>[^<]+)</CosmosVersion>"
      ],
      "depNameTemplate": "CosmosVersion",
      "packageNameTemplate": "CosmosVersion",
      "datasourceTemplate": "nuget",
      "lookupNameTemplate": "Cosmos.Kernel",
      "versioningTemplate": "nuget",
      "autoReplaceStringTemplate": "<CosmosVersion>{{{newValue}}}</CosmosVersion>"
    }
  ]
}
